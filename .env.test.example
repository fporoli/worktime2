# Environment variables for the test environment (docker-compose.test.yml), deployed via
# Coolify. Configure these as environment variables on the Coolify "Docker Compose" resource
# itself (Coolify UI) - do not commit a real .env.test with secrets in it.

POSTGRES_USER=worktime
POSTGRES_PASSWORD=change-me
POSTGRES_DB=worktime

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Google identity provider (optional - leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure AD / Entra ID identity provider (optional - leave blank to disable Microsoft sign-in)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
